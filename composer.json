{
  "name": "studioespresso/craft-seo-fields",
  "description": "Fields for your SEO & OG meta data",
  "type": "craft-plugin",
  "version": "6.0.0-alpha.1",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "seo fields"
  ],
  "support": {
    "docs": "https://studioespresso.github.io/craft-seo-fields/",
    "issues": "https://github.com/studioespresso/craft-seo-fields/issues"
  },
  "license": "proprietary",
  "authors": [
    {
      "name": "Studio Espresso",
      "homepage": "https://www.studioespresso.co"
    }
  ],
  "require": {
    "craftcms/cms": "^6.0.0-alpha.4",
    "spatie/schema-org": "^3.0.0",
    "openspout/openspout": "^v4|^v5"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.27",
    "orchestra/testbench": "^11.0"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "ci": "pint && phpstan --memory-limit=1G"
  },
  "autoload": {
    "psr-4": {
      "studioespresso\\seofields\\": "src/"
    }
  },
  "extra": {
    "name": "SEO Fields",
    "handle": "seo-fields",
    "hasCpSettings": true,
    "hasCpSection": true,
    "class": "studioespresso\\seofields\\SeoFields"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true
    }
  }
}
