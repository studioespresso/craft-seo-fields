{% import 'seo-fields/_includes/_list' as lists %}

{# v-pre: cp/Screen compiles this as a Vue template, and logged URLs come from visitors #}
<div class="cp-container" v-pre>
    <div class="seofields-list">
        {{ lists.search(list) }}

        {% if list.rows.isEmpty() %}
            <craft-empty label="{{ "No 404's have been logged."|t('seo-fields') }}"></craft-empty>
        {% else %}
            <table class="seofields-list__table">
                <thead>
                <tr>
                    <th scope="col">{{ 'URL'|t('seo-fields') }}</th>
                    {{ lists.sortHeader(list, 'Hits'|t('seo-fields'), 'counter') }}
                    {% if list.sites %}<th scope="col">{{ 'Site'|t('seo-fields') }}</th>{% endif %}
                    {{ lists.sortHeader(list, 'Last visit'|t('seo-fields'), 'dateLastHit') }}
                    {{ lists.sortHeader(list, 'Redirect'|t('seo-fields'), 'handled') }}
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('seo-fields') }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for row in list.rows %}
                    <tr>
                        <td class="seofields-list__url">{{ row.urlPath }}</td>
                        <td>{{ row.counter }}</td>
                        {% if list.sites %}<td>{{ list.sites[row.siteId] ?? '' }}</td>{% endif %}
                        <td>{{ row.dateLastHit ? row.dateLastHit|date('Y-m-d H:i') }}</td>
                        <td>
                            {% if row.redirectId %}
                                <a href="{{ cpUrl('seo-fields/redirects/' ~ row.redirectId) }}">{{ row.redirectUrl }}</a>
                            {% else %}
                                <craft-button size="small" icon="plus" href="{{ cpUrl('seo-fields/redirects/new', {pattern: row.urlPath, site: row.siteId, record: row.id}) }}">{{ 'Add redirect'|t('seo-fields') }}</craft-button>
                            {% endif %}
                        </td>
                        <td class="seofields-list__actions">
                            {{ lists.deleteButton(cpUrl('seo-fields/not-found/' ~ row.id ~ '/delete'), 'Are you sure you want to delete this 404?'|t('seo-fields')) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {{ lists.pagination(list) }}
    </div>
</div>
