{% import 'seo-fields/_includes/_list' as lists %}

{# v-pre: cp/Screen compiles this as a Vue template; patterns can come from logged 404s #}
<div class="cp-container" v-pre>
    <div class="seofields-list">
        {{ lists.search(list) }}

        {% if list.rows.isEmpty() %}
            <craft-empty label="{{ 'No redirects exist yet.'|t('seo-fields') }}"></craft-empty>
        {% else %}
            <table class="seofields-list__table">
                <thead>
                <tr>
                    {{ lists.sortHeader(list, 'Pattern/URL'|t('seo-fields'), 'pattern') }}
                    <th scope="col">{{ 'Redirect to'|t('seo-fields') }}</th>
                    {% if list.sites %}<th scope="col">{{ 'Site'|t('seo-fields') }}</th>{% endif %}
                    {{ lists.sortHeader(list, 'Hits'|t('seo-fields'), 'counter') }}
                    {{ lists.sortHeader(list, 'Matched by'|t('seo-fields'), 'matchType') }}
                    {{ lists.sortHeader(list, 'Last hit at'|t('seo-fields'), 'dateLastHit') }}
                    {{ lists.sortHeader(list, 'Method'|t('seo-fields'), 'method') }}
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('seo-fields') }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for row in list.rows %}
                    <tr>
                        <td class="seofields-list__url"><a href="{{ cpUrl('seo-fields/redirects/' ~ row.id) }}">{{ row.pattern }}</a></td>
                        <td class="seofields-list__url">{{ row.redirect }}</td>
                        {% if list.sites %}<td>{{ row.siteId ? (list.sites[row.siteId] ?? '') : 'All'|t('seo-fields') }}</td>{% endif %}
                        <td>{{ row.counter ?? 0 }}</td>
                        <td>{{ row.matchType == 'regexMatch' ? 'Regex match'|t('seo-fields') : 'Exact match'|t('seo-fields') }}</td>
                        <td>{{ row.dateLastHit ? row.dateLastHit|date('Y-m-d H:i') }}</td>
                        <td>{{ row.method }}</td>
                        <td class="seofields-list__actions">
                            {{ lists.deleteButton(cpUrl('seo-fields/redirects/' ~ row.id ~ '/delete'), 'Are you sure you want to delete this redirect?'|t('seo-fields')) }}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {{ lists.pagination(list) }}
    </div>
</div>
