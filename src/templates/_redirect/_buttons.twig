<div class="flex gap-2 items-center">
    <form method="post" action="{{ cpUrl('seo-fields/redirects/upload') }}" enctype="multipart/form-data">
        {{ csrfInput() }}
        <input type="file" name="file" id="seofields-import" accept=".csv" hidden onchange="this.form.submit();">
        <craft-button type="button" icon="upload" onclick="document.getElementById('seofields-import').click();">{{ 'Import CSV File'|t('seo-fields') }}</craft-button>
    </form>

    <craft-button href="{{ cpUrl('seo-fields/redirects/export', {site: site}|filter) }}" icon="download">{{ 'Export'|t('seo-fields') }}</craft-button>

    {% if currentUser.admin %}
        <form method="post" action="{{ cpUrl('seo-fields/redirects/clear-all') }}"
              onsubmit="return confirm({{ 'Are you sure you want to remove all redirects?'|t('seo-fields')|json_encode }})">
            {{ csrfInput() }}
            <craft-button type="submit" variant="danger">{{ 'Clear all'|t('seo-fields') }}</craft-button>
        </form>
    {% endif %}

    <craft-button href="{{ cpUrl('seo-fields/redirects/new') }}" variant="primary" icon="plus">{{ 'New redirect'|t('seo-fields') }}</craft-button>
</div>
