{% if imported %}
    <h2>{{ '{count} redirects imported'|t('seo-fields', {count: imported|length}) }}</h2>
{% else %}
    <h2>{{ 'No redirects could be imported, check the invalid redirects below'|t('seo-fields') }}</h2>
{% endif %}

{% if invalid %}
    <h2>{{ '{count} redirects could not be imported:'|t('seo-fields', {count: invalid|length}) }}</h2>
    <table class="data fullwidth">
        <thead>
        <tr>
            <th>{{ 'Pattern'|t('seo-fields') }}</th>
            <th>{{ 'Redirect'|t('seo-fields') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for row in invalid %}
            <tr>
                <td>{{ row|first }}</td>
                <td>{{ row|last }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
